{
  "name": "@ren-0208/dsh-ref-develop",
  "version": "0.4.0",
  "private": true,
  "description": "Memory and growth for DSH: distill reusable methods, lessons, knowledge, problem reviews and (optional) user preferences from past sessions, shared globally or per workspace, with an optional embedding index for semantic recall.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
